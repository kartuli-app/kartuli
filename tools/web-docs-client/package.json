{
  "name": "@kartuli/web-docs-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "dev": "pnpm generate-llm-bundle && vitepress dev",
    "build": "pnpm test && cd ../.. && pnpm exec vitepress build tools/web-docs-client && cd tools/web-docs-client && pnpm copy-llm-bundle && pnpm check-docs -- --built",
    "preview": "pnpm build && vitepress preview",
    "generate-llm-bundle": "node scripts/generate-llm-bundle.js",
    "copy-llm-bundle": "node scripts/copy-llm-bundle.js",
    "check-docs": "node scripts/check-docs.js",
    "test": "pnpm generate-llm-bundle && pnpm check-docs && node --test scripts/site-navigation.node-test.js"
  },
  "dependencies": {
    "@aether-labs/vitepress-mermaid": "catalog:",
    "@kartuli/docs": "workspace:*",
    "mermaid": "catalog:",
    "vitepress": "catalog:",
    "vue": "catalog:",
    "@vue/server-renderer": "catalog:"
  }
}
