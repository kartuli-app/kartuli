{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "extends": ["./biome.json"],
  "linter": {
    "rules": {
      "suspicious": {
        "noUndeclaredEnvVars": {
          "level": "warn",
          "options": {
            "allowedEnvVars": ["GITHUB_OUTPUT", "GITHUB_STEP_SUMMARY"]
          }
        }
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!apps/**",
      "!packages/**",
      "!tools/**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/.next",
      "!**/lib",
      "!**/coverage",
      "!**/storybook-static",
      "!**/.vitepress/cache",
      "!**/.vitepress/dist",
      "!**/pnpm-lock.yaml",
      "!**/*.md",
      "!**/next-env.d.ts",
      "!generate-docs-for-llm.ts",
      "!**/diagrams/output"
    ]
  }
}
