{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "customManagers": [
    {
      "customType": "jsonata",
      "datasourceTemplate": "npm",
      "depNameTemplate": "@biomejs/biome",
      "fileFormat": "json",
      "managerFilePatterns": ["/(^|/)biome(?:\\.root)?\\.(json|jsonc)$/"],
      "matchStrings": ["{\"currentValue\": $split($.\"$schema\",(\"/\"))[-2]}"]
    }
  ],
  "enabledManagers": ["npm", "custom.jsonata"],
  "ignorePaths": [".nvmrc"],
  "schedule": ["before 3am on Monday"],
  "labels": ["type:chore", "scope:global"],
  "vulnerabilityAlerts": {
    "labels": ["security", "type:chore", "scope:global"],
    "groupName": "security updates",
    "prCreation": "immediate",
    "vulnerabilityFixStrategy": "lowest"
  },
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "commitMessageAction": "update dependencies",
  "commitMessageTopic": "{{depName}}",
  "automerge": false,
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "separateMultipleMajor": false,
  "packageRules": [
    {
      "matchPackageNames": ["typescript"],
      "matchCurrentVersion": "<7",
      "allowedVersions": "<7",
      "description": "Keep Storybook's legacy compiler on TypeScript 6 until docgen supports TypeScript 7"
    },
    {
      "matchPackageNames": ["vitest", "@vitest/**"],
      "allowedVersions": "<5",
      "description": "Keep the Vitest runner and its browser and coverage integrations on version 4"
    },
    {
      "matchUpdateTypes": ["security"],
      "groupName": "security updates",
      "groupSingleUpdates": false,
      "schedule": ["at any time"]
    },
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "groupName": "all dependencies",
      "groupSingleUpdates": false
    },
    {
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "matchPackageNames": ["pnpm"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25",
      "description": "Pin @types/node to 24.x to match Node 24 runtime"
    }
  ]
}
